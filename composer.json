{
    "name": "erikhoffman/sqlite-events",
    "description": "A small PHP library that turns SQLite inserts, updates, and deletes into PHP events.",
    "version": "0.1.0",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "autoload": {
        "psr-4": {
            "SQLiteEvents\\": "src/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "phpstan": "vendor/bin/phpstan analyse",
        "php:cs:fixer": "vendor/bin/php-cs-fixer fix src"
    },
    "require-dev": {
        "pestphp/pest": "4.4.*",
        "friendsofphp/php-cs-fixer": "^3.88",
        "phpstan/phpstan": "2.1.*"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3"
        }
    }
}
